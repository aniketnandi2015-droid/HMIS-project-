# ==============================================================================
# PharmaAssist Environment Configuration Template
# ==============================================================================

# Supabase Public API Configuration (Client-safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Next.js / Vercel compatibility alias
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Only Service Role Key (NEVER expose to browser client!)
# SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key-here

# App environment
VITE_APP_ENV=production
